    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "nodemailer": "^10.1.6",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
